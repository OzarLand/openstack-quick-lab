# openstack-quick-lab, OpenStack cloud variant: settings.
# Copy this file to config.env and fill it in. config.env is ignored by git: never commit it.

# --- Names -------------------------------------------------------------------
# Every resource the scripts create starts with this prefix.
PREFIX="quicklab-"
# Name of this lab: the VM is "${PREFIX}${LAB}" (default: quicklab-1).
LAB="1"

# --- Your cloud ----------------------------------------------------------------
# The entry of your clouds.yaml to use (~/.config/openstack/clouds.yaml). Credentials stay in that file.
OS_CLOUD="<your-cloud>"
# A network of your project where the VM gets its address. It needs a router to the Internet,
# unless you set HTTPS_PROXY below.
NETWORK="<your-network>"
# Optional: the external network to take a floating IP from, if you reach the VM from outside the cloud.
# Leave empty to reach the VM on its address in NETWORK (for example from another VM of the project).
FLOATING_NETWORK=""
# Who may SSH to the VM: your own public address, as a CIDR (for example 198.51.100.7/32).
# Do not use 0.0.0.0/0.
SSH_FROM="<your-address>/32"
# Optional: force a flavor or an image by name. Empty: the scripts choose one
# (at least 4 vCPU, 16 GB of RAM and 50 GB of disk; the most recent active image named like "Ubuntu 24.04").
FLAVOR=""
IMAGE=""
# Volume type of the root volume, used only when the flavor has no 50 GB disk. Empty: the cloud's default type
# (some clouds have none: then set one, see "openstack volume type list").
VOLUME_TYPE=""
# The login user of the image (Ubuntu cloud images: ubuntu).
SSH_USER="ubuntu"

# --- Cost ----------------------------------------------------------------------
# Price per hour of the chosen flavor (and floating IP, if any), from your provider's price list, with a dot
# (for example 0.196). create.sh shows the estimate and asks for confirmation before creating anything; it refuses
# to start while this is empty, unless you run ./create.sh --no-cost-estimate.
COST_PER_HOUR=""
CURRENCY="EUR"

# --- Only if your project has no direct Internet access ----------------------------
# An HTTP proxy that allows CONNECT to port 443, reachable from NETWORK (for example http://192.0.2.10:3128).
HTTPS_PROXY=""
# An NTP server reachable from NETWORK, if UDP to the Internet is blocked. Empty: the image's default.
NTP_SERVER=""
# "yes" if outbound HTTP (port 80) is blocked: apt then uses the Ubuntu mirrors over HTTPS.
APT_HTTPS="no"
# Optional: a registry that holds the Kolla images (for example 192.0.2.10:4000), plain HTTP, and its tag.
# Empty: images come from quay.io (Kolla-Ansible's default) with the release tag.
DOCKER_REGISTRY=""
OPENSTACK_TAG=""

# --- Versions (tested together; change them together) ------------------------
KOLLA_ANSIBLE_VERSION="22.2.0"   # OpenStack 2026.1
ANSIBLE_CORE_VERSION="2.20.10"
# Address range of the lab's own external network (inside the VM only). Must not overlap NETWORK.
LAB_EXT_CIDR="10.99.0.0/24"
