# openstack-quick-lab, OpenStack cloud multinode variant: settings.
# Copy this file to config.env and fill it in. config.env is ignored by git: never commit it.

# --- Size of the lab -------------------------------------------------------------
# 1 controller (no HAProxy) or 3 controllers (HAProxy, keepalived, a Galera and RabbitMQ cluster).
CONTROLLERS="1"
# Computes: 2 lets you try live migration between them.
COMPUTES="2"

# --- Names -------------------------------------------------------------------
# Every resource the scripts create starts with "${PREFIX}${LAB}-" (default: quicklab-multi-1-).
PREFIX="quicklab-multi-"
LAB="1"

# --- Your cloud ----------------------------------------------------------------
# The entry of your clouds.yaml to use (~/.config/openstack/clouds.yaml). Credentials stay in that file.
OS_CLOUD="<your-cloud>"
# A network of your project where the VMs get their addresses. It needs a router to the Internet,
# unless you set HTTPS_PROXY below. The scripts also create one network of their own for the lab's floating IPs.
NETWORK="<your-network>"
# Optional: the external network to take a floating IP from for controller 1, if you reach it from outside the cloud.
# Leave empty to reach controller 1 on its address in NETWORK (for example from another VM of the project).
FLOATING_NETWORK=""
# Who may SSH to the VMs: your own public address, as a CIDR (for example 198.51.100.7/32). Do not use 0.0.0.0/0.
SSH_FROM="<your-address>/32"
# Optional: force the flavors or the image by name. Empty: the scripts choose the smallest flavor with at least
# 4 vCPU, 16 GB of RAM (controllers) or 8 GB (computes), and 50 GB of disk; and the most recent active image named
# like "Ubuntu 24.04".
CONTROLLER_FLAVOR=""
COMPUTE_FLAVOR=""
IMAGE=""
# Volume type of the root volumes, used only when a flavor has no 50 GB disk. Empty: the cloud's default type.
VOLUME_TYPE=""
# The login user of the image (Ubuntu cloud images: ubuntu).
SSH_USER="ubuntu"

# --- Cost ----------------------------------------------------------------------
# Price per hour of one controller and of one compute (their flavors), from your provider's price list, with a dot
# (for example 0.196). Add in COST_PER_HOUR_EXTRA what your provider bills apart for the whole lab: root volumes,
# the floating IP. create.sh shows the total for the lab's size and asks for confirmation before creating anything;
# it refuses to start while the two prices are empty, unless you run ./create.sh --no-cost-estimate.
COST_PER_HOUR_CONTROLLER=""
COST_PER_HOUR_COMPUTE=""
COST_PER_HOUR_EXTRA="0"
CURRENCY="EUR"

# --- Only if your project has no direct Internet access ----------------------------
# An HTTP proxy that allows CONNECT to port 443, reachable from NETWORK (for example http://192.0.2.10:3128).
HTTPS_PROXY=""
# An NTP server reachable from NETWORK, if UDP to the Internet is blocked. Empty: the image's default.
NTP_SERVER=""
# "yes" if outbound HTTP (port 80) is blocked: apt then uses the Ubuntu mirrors over HTTPS.
APT_HTTPS="no"
# Optional: a registry that holds the Kolla images (for example 192.0.2.10:4000), plain HTTP, and its tag.
# Empty: images come from quay.io (Kolla-Ansible's default) with the release tag.
DOCKER_REGISTRY=""
OPENSTACK_TAG=""

# --- Versions (tested together; change them together) ------------------------
KOLLA_ANSIBLE_VERSION="22.2.0"   # OpenStack 2026.1
ANSIBLE_CORE_VERSION="2.20.10"
# Address range of the lab's external network (the floating IPs). The scripts create it as a network of your
# project, without gateway or DHCP. Must not overlap NETWORK.
LAB_EXT_CIDR="10.99.0.0/24"
